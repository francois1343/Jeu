# Copiez ce fichier vers supabase/functions/.env pour le developpement local.
# Ne validez jamais le fichier .env reel dans Git.

# Origines autorisees, separees par des virgules et sans slash final.
ALLOWED_ORIGINS=http://127.0.0.1:4173,http://localhost:4173

# Requis uniquement quand les publicites recompensees seront activees.
# Generez une valeur longue et aleatoire dans un gestionnaire de mots de passe.
REWARDED_AD_WEBHOOK_SECRET=remplacer-par-un-secret-aleatoire
